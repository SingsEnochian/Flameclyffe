# Copy to .env and fill locally. Never commit real credentials.

# Shared provider credential for DeepSeek-hosted profiles.
DEEPSEEK_API_KEY=replace-me

# Optional local OpenAI-compatible endpoint credential. Leave as local-only dummy if the server does not require one.
LOCAL_OPENAI_API_KEY=local

# Separate Discord applications, one per companion.
YGGDRASIL_DISCORD_TOKEN=replace-me
VEE_DISCORD_TOKEN=replace-me
FAER_DISCORD_TOKEN=replace-me
BLUEBIRD_DISCORD_TOKEN=replace-me
VETHRLAUF_DISCORD_TOKEN=replace-me

# House bootstrap. Use Developer Mode > Copy Server ID and Copy User ID.
DISCORD_GUILD_ID=
HOUSE_CARETAKER_USER_IDS=

# Restrict the rail to Rowan, Voice Lantern, and the Hearthweave rooms.
ALLOWED_HUMAN_USER_IDS=
VOICE_LANTERN_USER_IDS=
ALLOWED_CHANNEL_IDS=

# Optional shared tuning.
MAX_HISTORY_MESSAGES=18
REPLY_CHUNK_CHARS=1800
