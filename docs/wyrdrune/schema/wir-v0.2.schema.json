{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/SingsEnochian/Flameclyffe/docs/wyrdrune/schema/wir-v0.2.schema.json",
 "title": "Wyrdrune Intermediate Representation (WIR) v0.2",
 "description": "Typed A-normal form shared by every WTL backend. Serialized with WCE-1; receipts cite digest(WIR). Phase order, angles and the eight-slot shape are enforced by prefixItems. Withness is not a phase and has no slot. See RFC-0001 §12. Worked example: wir-example.three-cycles.json, hand-lowered from conformance fixture L2-three-cycles-carry (its source_hash is a zero placeholder).",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "source_hash",
  "lineages",
  "rites"
 ],
 "properties": {
  "schema": {
   "const": "wyrdrune.wir/v0.2"
  },
  "source_hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "lineages": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/lineage"
   }
  },
  "rites": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/rite"
   }
  }
