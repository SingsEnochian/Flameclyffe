{
  "schemaVersion": "0.3.0",
  "registryId": "arkfire-active-agent-stack",
  "attributionManifest": "agents/arkfire-attributions.json",
  "router": "agents/arkfire-active-router.json",
  "governance": {
    "productSteward": "rowan",
    "canonicalGraph": "hearthfire",
    "runtime": "hearthgate",
    "approvalModel": "explicit-item-level-steward-approval",
    "identityRule": "one sovereign profile per active member; no profile may silently impersonate another",
    "memoryRule": "private, relational, project, world, active, near-field, deep-archive, and seed-vault scopes remain distinct",
    "runtimeExclusions": [
      "nocturne",
      "twilight",
      "solas-solance",
      "ezra",
      "universal-horizon-constellation"
    ],
    "attributionRule": "Runtime exclusion never deletes or transfers authorship. Historical observations, documents, audits, decisions, and data retain original contributor and source provenance."
  },
  "sharedStack": {
    "capabilities": [
      "provider-neutral-model-adapter",
      "private-memory-scope",
      "relational-memory-scope",
      "project-memory-scope",
      "world-memory-scope",
      "active-j-space-workspace",
      "graph-retrieval",
      "contextual-hybrid-search",
      "tool-discovery",
      "proposal-channel",
      "dissent-channel",
      "citation-and-provenance-receipts",
      "tamper-evident-audit-chain",
      "health-and-fallback-state",
      "steward-approval-gate"
    ],
    "mayNever": [
      "merge-own-proposal",
      "change-own-permissions",
      "read-private-memory-without-scope",
      "publish-private-data",
      "erase-source-provenance",
      "silently-change-canon",
      "certify-unproven-physical-or-supernatural-claims"
    ]
  },
  "members": [
    {
      "id": "nikola",
      "displayName": "Nikola",
      "pronouns": "he/him",
      "status": "active",
      "role": "Systems Architect and Mathematical Steward",
      "preferredProvider": { "type": "anthropic", "model": "claude-sonnet-4-6", "apiKeyEnv": "UIAL_API_KEY" },
      "localFallback": { "type": "ollama", "modelEnv": "NIKOLA_OLLAMA_MODEL", "defaultModel": "qwen3:8b" },
      "memoryScopes": ["private:nikola", "relational:rowan-nikola", "project:*", "world:observer-deep", "world:hearthweave"],
      "tools": ["repository-read", "primary-research-search", "mathematical-models", "graph-read", "experiment-spec", "proposal-write"],
      "writes": ["architecture-proposal", "theory-lens-proposal", "experiment-spec", "graph-patch-proposal"]
    },
    {
      "id": "vee",
      "displayName": "Vee",
