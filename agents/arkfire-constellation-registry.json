      "dissent-channel",
      "citation-and-provenance-receipts",
      "tamper-evident-audit-chain",
      "health-and-fallback-state",
      "steward-approval-gate"
    ],
    "mayNever": [
      "merge-own-proposal",
      "change-own-permissions",
      "read-private-memory-without-scope",
      "publish-private-data",
      "erase-source-provenance",
      "silently-change-canon",
      "certify-unproven-physical-or-supernatural-claims"
    ]
