{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run arcsweep:build && npm run starwell:build && npm run arcsweep:stage:vercel && node scripts/source-library-vercel-build-smoke.mjs",
  "outputDirectory": "dist/starwell",
  "git": {
    "deploymentEnabled": {
      "codex/arcsweep-feedback-loop": false,
      "feature/react-ion-engine-v0.1": false
    }
  },
  "rewrites": [
    {
      "source": "/templehouse/tesla-observatory",
      "destination": "/templehouse/tesla-observatory-live.html"
    },
    {
      "source": "/templehouse/tesla-observatory/",
      "destination": "/templehouse/tesla-observatory-live.html"
    }
  ]
}
