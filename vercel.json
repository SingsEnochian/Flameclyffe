{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run arcsweep:build && npm run starwell:build && npm run arcsweep:stage:vercel",
  "outputDirectory": "dist/starwell",
  "git": {
    "deploymentEnabled": {
      "codex/arcsweep-feedback-loop": false,
      "feature/react-ion-engine-v0.1": false
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/telegram/house",
      "destination": "/api/v1/house/commons?transport=telegram"
    },
    {
      "source": "/api/v1/house/caretaker",
      "destination": "/api/v1/house/rooms?house_action=caretaker"
    },
    {
      "source": "/templehouse/tesla-observatory",
      "destination": "/templehouse/tesla-observatory-live.html"
    },
    {
      "source": "/templehouse/tesla-observatory/",
      "destination": "/templehouse/tesla-observatory-live.html"
    }
  ]
}
