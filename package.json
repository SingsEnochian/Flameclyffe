{
  "name": "flameclyffe-workshop",
  "private": true,
  "type": "module",
  "scripts": {
    "sigil:dev": "vite --config apps/sigil-activator/vite.config.js",
    "sigil:build": "vite build --config apps/sigil-activator/vite.config.js",
    "sigil:preview": "vite preview --config apps/sigil-activator/vite.config.js",
    "starwell:dev": "vite --config apps/starwell/vite.config.js",
    "starwell:build": "vite build --config apps/starwell/vite.config.js",
    "starwell:build:with-pocket-vercel": "vite build --config apps/starwell/vite.config.js && vite build --config apps/pocket-concordance-lens/vite.vercel.config.js",
    "starwell:preview": "vite preview --config apps/starwell/vite.config.js",
    "starwell:test": "node --test apps/starwell/test/*.test.js",
    "arcsweep:dev": "vite --config apps/arcsweep/vite.config.js",
    "arcsweep:build": "vite build --config apps/arcsweep/vite.config.js",
    "arcsweep:preview": "vite preview --config apps/arcsweep/vite.config.js",
    "arcsweep:test": "node --test apps/arcsweep/test/*.test.js apps/arcsweep/test/*.test.cjs",
    "arcsweep:stage:desktop": "node apps/arcsweep/desktop/stage.cjs",
    "arcsweep:desktop:install": "npm install --prefix apps/arcsweep/desktop",
    "arcsweep:desktop:pack:win": "npm run arcsweep:build && npm run arcsweep:stage:desktop && npm run arcsweep:desktop:install && npm --prefix apps/arcsweep/desktop run electron:pack:win",
    "arcsweep:desktop:build:win": "npm run arcsweep:build && npm run arcsweep:stage:desktop && npm run arcsweep:desktop:install && npm --prefix apps/arcsweep/desktop run electron:build:win",
    "pocket:dev": "vite --config apps/pocket-concordance-lens/vite.config.js",
    "pocket:build": "vite build --config apps/pocket-concordance-lens/vite.config.js",
    "pocket:preview": "vite preview --config apps/pocket-concordance-lens/vite.config.js",
    "project-zero:dev": "vite --config apps/project-zero-companion/vite.config.js",
    "project-zero:build": "vite build --config apps/project-zero-companion/vite.config.js",
    "project-zero:preview": "vite preview --config apps/project-zero-companion/vite.config.js",
    "everos:health": "node sandbox/everos/health.mjs",
    "everos:seed": "node sandbox/everos/seed-starwell.mjs",
    "everos:store": "node sandbox/everos/store-memory.mjs",
    "everos:search": "node sandbox/everos/search-memory.mjs"
  },
  "dependencies": {
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "@supabase/supabase-js": "latest",
    "@vitejs/plugin-react": "latest",
    "astronomia": "^4.2.0",
    "docx": "latest",
    "react": "latest",
    "react-dom": "latest",
    "slot-text": "0.2.2",
    "three": "latest",
    "vite": "latest"
  },
  "devDependencies": {}
}
