{
  "dataset_id": "deep-theory",
  "display_name": "DEEPTheory",
  "schema_version": "0.1.0",
  "record_schema": "../schemas/deep-theory.schema.json",
  "parallel_to": ["DEEPStory", "DEEPTime"],
  "purpose": "Preserve analytical patterns, correlations, topology models, transition models, hypotheses and cross-observation comparisons without rewriting source observations or narrative continuity.",
  "source_policy": {
    "raw_sources_immutable": true,
    "analyses_append_only": true,
    "silent_canonicalisation_forbidden": true,
    "cross_domain_numeric_equivalence_assumed": false
  },
  "review_policy": {
    "candidate_requires_human_review": true,
    "model_output_is_not_automatic_physical_claim": true,
    "canon_commit_is_separate": true
  },
  "routing": {
    "from_arcsweep_domain_control_sweep": "candidate",
    "from_deep_time_pattern_analysis": "candidate",
    "from_external_research": "candidate",
    "accepted_records_may_feed": ["Theory-Grounded Acceptance Advisor", "Runa", "Arcsweep", "DEEPStory"]
  }
}
