{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flameclyffe.local/schemas/deep-story.schema.json",
  "title": "DEEPStory Narrative Continuity Record",
  "description": "Parallel narrative dataset for ordering witnessed, recorded, derived, interpreted, remembered, correlated, mythic, speculative, or fictionalised material without altering the source DEEPTheory and witness records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_kind",
    "id",
    "created_at",
    "title",
    "narrative_mode",
    "source_refs",
    "events",
    "source_integrity",
    "consent_scope",
    "privacy_scope"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "dataset_kind": {
      "type": "string",
      "const": "deep_story"
    },
    "parallel_dataset": {
      "type": "string",
      "const": "DEEPTheory",
      "default": "DEEPTheory"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": ["string", "null"]
    },
    "narrative_mode": {
      "enum": [
        "documentary",
        "continuity",
        "interpretive",
        "mythic",
        "speculative",
        "fictionalised"
      ]
    },
    "canon_state": {
      "enum": ["draft", "reviewed", "accepted", "superseded", "retired"],
      "default": "draft"
    },
    "narrator_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/storyEvent" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entityRef" },
      "default": []
    },
    "places": {
      "type": "array",
      "items": { "$ref": "#/$defs/placeRef" },
      "default": []
    },
    "motifs": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "description", "source_refs"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "description": { "type": "string" },
          "source_refs": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "status": {
            "enum": ["witnessed", "recorded", "derived", "interpreted", "remembered", "correlated", "unknown"]
          }
        }
      },
      "default": []
    },
    "unresolved_threads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "status"],
        "properties": {
          "question": { "type": "string" },
          "status": { "enum": ["open", "watching", "answered", "set_aside"] },
          "source_refs": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "note": { "type": ["string", "null"] }
        }
      },
      "default": []
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "enum": ["glyph", "image", "sound", "tone", "video", "map", "text", "font", "other"] },
          "ref": { "type": "string" },
          "role": { "type": ["string", "null"] }
        }
      },
      "default": []
    },
    "source_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_sources_immutable", "interpretations_append_only"],
      "properties": {
        "raw_sources_immutable": { "type": "boolean", "const": true },
        "interpretations_append_only": { "type": "boolean", "const": true },
        "verification_note": { "type": ["string", "null"] }
      }
    },
    "consent_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "sequence", "interpret", "render", "link_sources"],
      "properties": {
        "store": { "type": "boolean" },
        "sequence": { "type": "boolean" },
        "interpret": { "type": "boolean" },
        "render": { "type": "boolean" },
        "link_sources": { "type": "boolean" },
        "share_with_constellation": { "type": "boolean", "default": false },
        "notes": { "type": ["string", "null"] }
      }
    },
    "privacy_scope": {
      "enum": ["private_local", "private_account", "named_constellation", "project", "export_only"]
    },
    "append_only_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["created_at", "kind", "text"],
        "properties": {
          "created_at": { "type": "string", "format": "date-time" },
          "kind": {
            "enum": [
              "correction",
              "addition",
              "resequence",
              "reinterpretation",
              "canon_change",
              "consent_change",
              "privacy_change"
            ]
          },
          "text": { "type": "string" },
          "author_id": { "type": ["string", "null"] },
          "source_refs": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        }
      },
      "default": []
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "dataset", "record_type"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "dataset": {
          "enum": [
            "DEEPTheory",
            "observer_witness",
            "companion_observation",
            "PREMAQ",
            "Lattice",
            "archive",
            "external"
          ]
        },
        "record_type": {
          "enum": ["witnessed", "recorded", "derived", "interpreted", "remembered", "correlated", "unknown"]
        },
        "checksum": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    },
    "storyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "text", "epistemic_status", "narrative_treatment", "source_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "occurred_at_start": { "type": ["string", "null"], "format": "date-time" },
        "occurred_at_end": { "type": ["string", "null"], "format": "date-time" },
        "scene": { "type": ["string", "null"] },
        "text": { "type": "string", "minLength": 1 },
        "epistemic_status": {
          "enum": ["witnessed", "recorded", "derived", "interpreted", "remembered", "correlated", "unknown"]
        },
        "narrative_treatment": {
          "enum": ["verbatim", "paraphrased", "sequenced", "interpreted", "mythologised", "speculated", "fictionalised"]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "entity_refs": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "place_refs": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "motifs": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "uncertainty": { "type": ["string", "null"] }
      }
    },
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "role"],
      "properties": {
        "ref": { "type": "string" },
        "role": { "type": "string" },
        "display_name": { "type": ["string", "null"] }
      }
    },
    "placeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "role"],
      "properties": {
        "ref": { "type": "string" },
        "role": { "type": "string" },
        "display_name": { "type": ["string", "null"] }
      }
    }
  }
}
