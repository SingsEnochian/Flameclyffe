{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flameclyffe.local/schemas/bifrost-current-interface-export-v0.5.schema.json",
  "title": "Bifröst Current Interface Export v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "exported_at",
    "source",
    "bifrost_runtime",
    "current_state",
    "source_state",
    "cycle_receipts",
    "cycle_receipt_envelopes",
    "cycle_envelope_count",
    "authority",
    "compatibility"
  ],
  "$defs": {
    "executionSide": {
      "enum": [
        "hearthside",
        "targetside"
      ]
    },
    "sourceKind": {
      "enum": [
        "local-reference",
        "temporal-state",
        "premaq-only",
        "missing"
      ]
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_write_performed",
        "tone_approval_performed",
        "physical_device_test_performed"
      ],
      "properties": {
        "canon_write_performed": {
          "const": false
        },
        "tone_approval_performed": {
          "const": false
        },
        "physical_device_test_performed": {
          "const": false
        }
      }
    },
    "sourceBindingReceipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "selected_side",
        "source_kind",
        "source_state_id",
        "source_fingerprint",
        "certified_source"
      ],
      "properties": {
        "schema": {
          "const": "bifrost.source-binding-receipt/v0.1"
        },
        "selected_side": {
          "$ref": "#/$defs/executionSide"
        },
        "source_kind": {
          "$ref": "#/$defs/sourceKind"
        },
        "source_state_id": {
          "type": "string",
          "minLength": 1
        },
        "source_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "certified_source": {
          "type": "boolean"
        }
      }
    },
    "executionSource": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "selected_side",
        "source_kind",
        "source_state_id",
        "source_fingerprint"
      ],
      "properties": {
        "selected_side": {
          "$ref": "#/$defs/executionSide"
        },
        "source_kind": {
          "$ref": "#/$defs/sourceKind"
        },
        "source_state_id": {
          "type": "string",
          "minLength": 1
        },
        "source_fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeShore": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeBridge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "crossing_ready",
        "certified"
      ],
      "properties": {
        "status": {
          "enum": [
            "LOCAL REFERENCE",
            "TEMPORAL HEARTHSIDE",
            "TEMPORAL TARGETSIDE",
            "OBSERVABLE PREMAQ ONLY",
            "EXPERIENTIAL PREMAQ_ONLY",
            "NOT PROVIDED",
            "SHORE_STATE_INCOMPLETE",
            "HIDDEN_STATE_DIVERGENCE",
            "TWO_SHORE_PREMAQ_VISIBLE"
          ]
        },
        "crossing_ready": {
          "type": "boolean"
        },
        "certified": {
          "type": "boolean"
        }
      }
    },
    "runtimeState": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "packet_id",
        "shared_state_fingerprint",
        "active_execution_side",
        "bridge",
        "hearthside",
        "targetside"
      ],
      "properties": {
        "schema": {
          "const": "bifrost.runtime-state/v0.1"
        },
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "shared_state_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "active_execution_side": {
          "$ref": "#/$defs/executionSide"
        },
        "bridge": {
          "$ref": "#/$defs/runtimeBridge"
        },
        "hearthside": {
          "$ref": "#/$defs/runtimeShore"
        },
        "targetside": {
          "$ref": "#/$defs/runtimeShore"
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "bridge_status",
        "crossing_ready",
        "certified",
        "blocked_actions"
      ],
      "properties": {
        "schema": {
          "const": "bifrost.runtime-execution-policy/v0.1"
        },
        "bridge_status": {
          "type": "string",
          "minLength": 1
        },
        "crossing_ready": {
          "type": "boolean"
        },
        "certified": {
          "type": "boolean"
        },
        "blocked_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nativeActionReceipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "action_id",
        "selected_execution_side",
        "execution_source",
        "source_binding_receipt"
      ],
      "properties": {
        "schema": {
          "const": "bifrost.native-action-receipt/v0.2"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "selected_execution_side": {
          "$ref": "#/$defs/executionSide"
        },
        "execution_source": {
          "$ref": "#/$defs/executionSource"
        },
        "source_binding_receipt": {
          "$ref": "#/$defs/sourceBindingReceipt"
        }
      }
    },
    "cycleReceipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "cycle",
        "receipt_id",
        "from_state_id",
        "to_state_id",
        "next_operation"
      ],
      "properties": {
        "cycle": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "from_state_id": {
          "type": "string",
          "minLength": 1
        },
        "to_state_id": {
          "type": "string",
          "minLength": 1
        },
        "next_operation": {
          "const": "compression-of-release"
        }
      }
    },
    "cycleReceiptEnvelope": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "envelope_id",
        "exported_at",
        "action_id",
        "cycle",
        "cycle_receipt_id",
        "from_state_id",
        "to_state_id",
        "next_operation",
        "selected_execution_side",
        "source_kind",
        "source_state_id",
        "source_fingerprint",
        "bridge_status",
        "crossing_ready",
        "certified_source",
        "packet_id",
        "shared_state_fingerprint",
        "hearthside_state_id",
        "hearthside_fingerprint",
        "targetside_state_id",
        "targetside_fingerprint",
        "cycle_receipt",
        "source_binding_receipt",
        "native_action_receipt",
        "execution_policy",
        "authority",
        "notes"
      ],
      "properties": {
        "schema": {
          "const": "bifrost.cycle-receipt-envelope/v0.1"
        },
        "envelope_id": {
          "type": "string",
          "minLength": 1
        },
        "exported_at": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "cycle": {
          "type": "integer",
          "minimum": 0
        },
        "cycle_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "from_state_id": {
          "type": "string",
          "minLength": 1
        },
        "to_state_id": {
          "type": "string",
          "minLength": 1
        },
        "next_operation": {
          "const": "compression-of-release"
        },
        "selected_execution_side": {
          "$ref": "#/$defs/executionSide"
        },
        "source_kind": {
          "$ref": "#/$defs/sourceKind"
        },
        "source_state_id": {
          "type": "string",
          "minLength": 1
        },
        "source_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "bridge_status": {
          "type": "string",
          "minLength": 1
        },
        "crossing_ready": {
          "type": "boolean"
        },
        "certified_source": {
          "type": "boolean"
        },
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "shared_state_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "hearthside_state_id": {
          "type": "string",
          "minLength": 1
        },
        "hearthside_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "targetside_state_id": {
          "type": "string",
          "minLength": 1
        },
        "targetside_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "cycle_receipt": {
          "$ref": "#/$defs/cycleReceipt"
        },
        "source_binding_receipt": {
          "$ref": "#/$defs/sourceBindingReceipt"
        },
        "native_action_receipt": {
          "$ref": "#/$defs/nativeActionReceipt"
        },
        "execution_policy": {
          "$ref": "#/$defs/executionPolicy"
        },
        "authority": {
          "$ref": "#/$defs/authorityBoundary"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stateReference": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "state_id"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "bifrost.current-interface-export/v0.5"
    },
    "exported_at": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode",
        "packet_fingerprint",
        "source_state_id",
        "selected_execution_side",
        "execution_source",
        "source_binding_receipt"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "packet_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "source_state_id": {
          "type": "string",
          "minLength": 1
        },
        "selected_execution_side": {
          "$ref": "#/$defs/executionSide"
        },
        "execution_source": {
          "$ref": "#/$defs/executionSource"
        },
        "source_binding_receipt": {
          "$ref": "#/$defs/sourceBindingReceipt"
        }
      }
    },
    "bifrost_runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "runtime_state",
        "execution_source",
        "source_binding_receipt",
        "execution_policy",
        "native_action_receipt"
      ],
      "properties": {
        "runtime_state": {
          "$ref": "#/$defs/runtimeState"
        },
        "execution_source": {
          "$ref": "#/$defs/executionSource"
        },
        "source_binding_receipt": {
          "$ref": "#/$defs/sourceBindingReceipt"
        },
        "execution_policy": {
          "$ref": "#/$defs/executionPolicy"
        },
        "native_action_receipt": {
          "$ref": "#/$defs/nativeActionReceipt"
        }
      }
    },
    "current_state": {
      "$ref": "#/$defs/stateReference"
    },
    "source_state": {
      "$ref": "#/$defs/stateReference"
    },
    "cycle_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cycleReceipt"
      }
    },
    "cycle_receipt_envelopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cycleReceiptEnvelope"
      }
    },
    "cycle_envelope_count": {
      "type": "integer",
      "minimum": 0
    },
    "authority": {
      "$ref": "#/$defs/authorityBoundary"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replaces_legacy_export_schema",
        "legacy_export_click_prevented",
        "sidecar_export_still_available"
      ],
      "properties": {
        "replaces_legacy_export_schema": {
          "const": "bifrost.current-interface-export/v0.4"
        },
        "legacy_export_click_prevented": {
          "const": true
        },
        "sidecar_export_still_available": {
          "const": true
        }
      }
    }
  }
}
