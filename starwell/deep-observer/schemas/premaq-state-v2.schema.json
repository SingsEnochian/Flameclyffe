{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flameclyffe.local/schemas/premaq-state-v2.schema.json",
  "title": "PREMAQ Observation State v2 — Braided Spine Registry",
  "description": "Seven-axis PREMAQ bearing governed by hearthgate.braided-spine/v1.0.0 and hearthgate.premaq-registry/v3.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "observed_at", "registry_version", "state", "receipt_id", "sequence", "model_version"],
  "$defs": {
    "sourceClass": {
      "enum": [
        "witnessed",
        "recorded",
        "derived",
        "model-interpreted",
        "human-interpreted",
        "remembered",
        "correlated",
        "simulated",
        "projected",
        "expressed",
        "received",
        "answered",
        "integrated",
        "unknown"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "derivative", "uncertainty", "confidence", "contributors"],
      "properties": {
        "status": { "enum": ["KNOWN", "BOUNDED", "SYMBOLIC", "UNKNOWN"] },
        "value": { "type": ["number", "null"] },
        "bounds": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "symbol": { "type": "string" },
        "derivative": { "type": ["number", "null"] },
        "derivative_bounds": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        },
        "uncertainty": { "type": ["number", "object", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_ref", "source_class", "weight", "method"],
            "properties": {
              "source_ref": { "type": "string" },
              "source_class": { "$ref": "#/$defs/sourceClass" },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 },
              "method": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "registry_version": { "type": "string", "minLength": 1 },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P", "C", "R", "E", "M", "A", "Q"],
      "properties": {
        "P": { "$ref": "#/$defs/component", "description": "Presence" },
        "C": { "$ref": "#/$defs/component", "description": "Coherence" },
        "R": { "$ref": "#/$defs/component", "description": "Resonance" },
        "E": { "$ref": "#/$defs/component", "description": "Entanglement" },
        "M": { "$ref": "#/$defs/component", "description": "Memory" },
        "A": { "$ref": "#/$defs/component", "description": "Agency" },
        "Q": { "$ref": "#/$defs/component", "description": "Qualia — lived interiority and the irreducible quality of experience" }
      }
    },
    "receipt_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "prior_state_ref": { "type": ["string", "null"] },
    "model_version": { "type": "string", "minLength": 1 },
    "provenance_refs": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
