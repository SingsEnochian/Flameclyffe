{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flameclyffe.local/schemas/semantic-metric.schema.json",
  "title": "Observer Semantic Metric",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "value", "source_class", "method", "created_at"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "value": { "type": ["number", "string", "boolean", "null"] },
    "unit": { "type": ["string", "null"] },
    "source_class": { "enum": ["witnessed", "recorded", "derived", "model-interpreted", "human-interpreted", "remembered", "correlated", "simulated", "projected", "unknown"] },
    "method": { "type": "string", "minLength": 1 },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "uncertainty": { "type": ["number", "string", "object", "null"] },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "model": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "prompt_version": { "type": ["string", "null"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
