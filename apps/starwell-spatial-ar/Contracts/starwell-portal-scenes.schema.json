{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starwell.local/contracts/starwell-portal-scenes.schema.json",
  "title": "STARWELL Portal Scene Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultSceneId", "scenes"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "defaultSceneId": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "hexColour": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "glyph",
        "accessibilityLabel",
        "palette",
        "motion",
        "assets",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": { "type": "string", "minLength": 1 },
        "glyph": { "type": "string", "minLength": 1 },
        "accessibilityLabel": { "type": "string", "minLength": 1 },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "secondary", "background", "accent"],
          "properties": {
            "primary": { "$ref": "#/$defs/hexColour" },
            "secondary": { "$ref": "#/$defs/hexColour" },
            "background": { "$ref": "#/$defs/hexColour" },
            "accent": { "$ref": "#/$defs/hexColour" }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "speed", "reducedMotionSpeed"],
          "properties": {
            "profile": { "type": "string", "minLength": 1 },
            "speed": { "type": "number", "minimum": 0 },
            "reducedMotionSpeed": { "type": "number", "minimum": 0 }
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interiorTextureKey", "ambientAudioKey"],
          "properties": {
            "interiorTextureKey": { "type": "string" },
            "ambientAudioKey": { "type": "string" }
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
