{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcsweep.cybersecurity-intelligence/v1",
  "title": "ArcSweep Cybersecurity Intelligence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "record_id", "source_id", "source_ref", "kind", "title", "risk_families", "observed_at", "provenance"],
  "properties": {
    "schema": { "const": "arcsweep.cybersecurity-intelligence/v1" },
    "record_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["technique", "attack-pattern", "weakness", "vulnerability", "known-exploited-vulnerability", "mitigation", "incident", "guidance", "control"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": ["string", "null"] },
    "risk_families": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "severity": { "enum": ["unknown", "low", "medium", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "affected_services": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capability_implications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "effect"],
        "properties": {
          "capability_id": { "type": "string" },
          "effect": { "enum": ["observe", "raise-confirmation", "lower-budget", "contain", "deny-until-review"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "observed_at": { "type": "string" },
    "expires_at": { "type": ["string", "null"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_url", "retrieved_at", "content_hash"],
      "properties": {
        "canonical_url": { "type": "string" },
        "retrieved_at": { "type": "string" },
        "content_hash": { "type": "string" },
        "signature": { "type": ["string", "null"] },
        "transformations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "raw_text_quarantined": { "type": "boolean" }
  }
}
