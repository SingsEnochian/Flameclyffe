{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcsweep.somatic-target/v1",
  "title": "ArcSweep Somatic Target",
  "type": "object",
  "required": ["schema", "target_id", "desired", "constraints", "arrival_conditions"],
  "properties": {
    "schema": { "const": "arcsweep.somatic-target/v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "label": { "type": ["string", "null"] },
    "desired": { "type": "object" },
    "constraints": { "type": "object" },
    "arrival_conditions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
