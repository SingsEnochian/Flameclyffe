{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcsweep.time-room-doorway/v1",
  "title": "ArcSweep Time Room Doorway",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "doorway_id",
    "universe_id",
    "destination_room",
    "label",
    "purpose",
    "reason",
    "rank",
    "recommended",
    "enterable",
    "requires_confirmation",
    "autonomous_entry",
    "held_reason"
  ],
  "properties": {
    "schema": { "const": "arcsweep.time-room-doorway/v1" },
    "doorway_id": { "type": "string", "minLength": 1, "maxLength": 260 },
    "universe_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "destination_room": { "type": "string", "minLength": 1, "maxLength": 80 },
    "label": { "type": "string", "minLength": 1, "maxLength": 160 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 700 },
    "rank": { "type": "integer", "minimum": 1 },
    "recommended": { "type": "boolean" },
    "enterable": { "type": "boolean" },
    "requires_confirmation": { "const": true },
    "autonomous_entry": { "const": false },
    "held_reason": { "type": ["string", "null"], "maxLength": 500 }
  }
}
