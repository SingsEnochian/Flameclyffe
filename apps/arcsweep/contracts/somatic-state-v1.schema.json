{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcsweep.somatic-state/v1",
  "title": "ArcSweep Somatic State",
  "type": "object",
  "required": ["schema", "state_id", "observed_at", "channels", "provenance"],
  "properties": {
    "schema": { "const": "arcsweep.somatic-state/v1" },
    "state_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "world_id": { "type": ["string", "null"] },
    "continuity_packet_id": { "type": ["string", "null"] },
    "channels": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
