{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcsweep.universe-time-profile/v1",
  "title": "ArcSweep Universe Time Profile",
  "type": "object",
  "required": ["schema", "universe_id", "title", "chamber", "time_law", "clocks", "entry_questions", "can_happen", "arrival_signals"],
  "properties": {
    "schema": { "const": "arcsweep.universe-time-profile/v1" },
    "universe_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "chamber": { "type": "string" },
    "time_law": { "type": "string", "minLength": 1 },
    "clocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clock_id", "layer", "label", "question"],
        "properties": {
          "clock_id": { "type": "string", "minLength": 1 },
          "layer": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "question": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "entry_questions": { "type": "array", "items": { "type": "string" } },
    "can_happen": { "type": "array", "items": { "type": "string" } },
    "arrival_signals": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
