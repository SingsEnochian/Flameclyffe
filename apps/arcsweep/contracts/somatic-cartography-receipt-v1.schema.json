{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcsweep.somatic-cartography-receipt/v1",
  "title": "ArcSweep Somatic Cartography Receipt",
  "type": "object",
  "required": ["schema", "receipt_id", "course_id", "step", "transition", "status", "capability_receipt_ids", "recorded_at"],
  "properties": {
    "schema": { "const": "arcsweep.somatic-cartography-receipt/v1" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "course_id": { "type": "string", "minLength": 1 },
    "step": { "type": "integer", "minimum": 1 },
    "transition": { "type": "string" },
    "status": { "enum": ["applied", "observed", "pending", "skipped", "failed"] },
    "observed_state_id": { "type": ["string", "null"] },
    "pending_id": { "type": ["string", "null"] },
    "capability_receipt_ids": { "type": "array", "items": { "type": "string" } },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
