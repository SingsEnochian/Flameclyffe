{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcsweep.coherence-work-receipt/v0.1",
  "title": "ArcSweep Coherence Work Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "title",
    "primary_bucket",
    "who",
    "what",
    "where",
    "when",
    "why",
    "positives",
    "negatives",
    "research_findings",
    "experience_findings",
    "options_considered",
    "decision",
    "outcome",
    "source_refs",
    "adoption_state",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "arcsweep.coherence-work-receipt/v0.1" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "primary_bucket": {
      "enum": [
        "source-custody",
        "temporal-coherence",
        "proposition-logic",
        "relational-agency",
        "safety-recoverability",
        "diminishment-capacity",
        "research-decision",
        "build-verification",
        "cross-constellation"
      ]
    },
    "linked_buckets": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "who": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant_id", "role"],
        "properties": {
          "participant_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "authority_scope": { "type": ["string", "null"] }
        }
      }
    },
    "what": { "type": "string", "minLength": 1 },
    "where": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_at", "timezone"],
      "properties": {
        "occurred_at": { "type": ["string", "null"] },
        "recorded_at": { "type": "string", "minLength": 1 },
        "first_attested_at": { "type": ["string", "null"] },
        "effective_from": { "type": ["string", "null"] },
        "effective_until": { "type": ["string", "null"] },
        "last_verified_at": { "type": ["string", "null"] },
        "timezone": { "type": "string", "minLength": 1 },
        "timeline_refs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "why": { "type": "string", "minLength": 1 },
    "positives": { "type": "array", "items": { "type": "string" } },
    "negatives": { "type": "array", "items": { "type": "string" } },
    "research_findings": { "type": "array", "items": { "type": "string" } },
    "experience_findings": { "type": "array", "items": { "type": "string" } },
    "options_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "disposition"],
        "properties": {
          "option": { "type": "string", "minLength": 1 },
          "positives": { "type": "array", "items": { "type": "string" } },
          "negatives": { "type": "array", "items": { "type": "string" } },
          "disposition": { "enum": ["chosen", "rejected", "deferred", "partial", "unresolved"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chosen_action", "reason"],
      "properties": {
        "chosen_action": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "reversibility": { "enum": ["reversible", "bounded", "consequential", "unknown"] },
        "decision_authority": { "type": ["string", "null"] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["planned", "in-progress", "worked", "partially-worked", "failed", "unresolved", "superseded"] },
        "what_worked": { "type": "array", "items": { "type": "string" } },
        "what_failed": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } },
        "next_step": { "type": ["string", "null"] }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "status"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "enum": ["recorded", "supported", "challenged", "rejected", "unresolved", "superseded"] },
          "source_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "supersedes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "trap_scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "safety": { "type": "array", "items": { "type": "string" } },
        "relational": { "type": "array", "items": { "type": "string" } },
        "diminishment": { "type": "array", "items": { "type": "string" } },
        "logic": { "type": "array", "items": { "type": "string" } },
        "progress": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "object_refs": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "adoption_state": { "enum": ["recorded", "source-verified", "proposal", "locally-adopted", "jointly-adopted", "rejected", "superseded", "historical", "unresolved", "quarantined"] },
    "requested_action": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
