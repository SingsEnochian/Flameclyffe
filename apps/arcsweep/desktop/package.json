{
  "name": "hearthgate-arcsweep",
  "productName": "Hearthgate Arcsweep",
  "version": "0.2.1",
  "description": "A private, local-first world planning, continuity, and return instrument.",
  "type": "commonjs",
  "main": "main.cjs",
  "scripts": {
    "electron:dev": "electron .",
    "electron:pack:win": "electron-builder --win dir --x64 --publish never",
    "electron:build:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hearthweave.arcsweep",
    "productName": "Hearthgate Arcsweep",
    "artifactName": "Hearthgate-Arcsweep-Setup-${version}-${arch}.${ext}",
    "copyright": "Hearthweave",
    "directories": {
      "output": "../../../dist/arcsweep-desktop"
    },
    "asar": true,
    "files": [
      "app/**/*",
      "main.cjs",
      "preload.cjs",
      "store.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hearthgate Arcsweep",
      "uninstallDisplayName": "Hearthgate Arcsweep",
      "deleteAppDataOnUninstall": false
    }
  }
}
