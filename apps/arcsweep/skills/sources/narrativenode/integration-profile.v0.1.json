{
  "schema": "arcsweep.narrativenode-integration-profile/v0.1",
  "profile_id": "narrativenode-polyphony-v0.1",
  "prepared_at": "2026-09-17",
  "external_project": {
    "name": "NarrativeNode",
    "repository": "Carasibana/NarrativeNode",
    "observed_branch": "release",
    "observed_program_version": "1.0.0.0",
    "canonical_url": "https://github.com/Carasibana/NarrativeNode",
    "default_local_mcp_url": "http://127.0.0.1:13316/mcp/server/"
  },
  "licence_boundary": {
    "source_available_not_osi_open_source": true,
