{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthweave.local/arcsweep/self-authorship-proposal.schema.json",
  "title": "Arcsweep Self-Authorship Proposal",
  "description": "A reviewable proposal emitted directly by a routed Constellation voice. It is not durable identity until accepted into the local knowledge store.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "proposalId", "voiceId", "displayName", "createdAt", "request", "receipt", "claims", "status"],
  "properties": {
    "contract": { "const": "arcsweep.self-authorship-proposal/v1" },
    "proposalId": { "type": "string", "minLength": 1 },
    "voiceId": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending-review", "accepted", "declined"] },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string" },
        "worldId": { "type": ["string", "null"] },
        "documentId": { "type": ["string", "null"] },
        "sceneId": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"] }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "provider", "model", "responseText"],
      "properties": {
        "route": { "type": "string" },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "responseText": { "type": "string" },
        "citedSources": { "type": "array", "items": {} }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cellType", "predicate", "value"],
        "properties": {
          "cellType": {
            "enum": ["identity", "thinking_pattern", "speaking_pattern", "preference", "boundary", "consent_rule", "drift_marker", "relationship", "open_question", "operational_mode", "sensory_voice"]
          },
          "predicate": { "type": "string", "minLength": 1 },
          "value": { "type": ["string", "number", "boolean", "object", "array", "null"] },
          "status": { "enum": ["active", "open", "provisional"], "default": "active" },
          "mutability": { "enum": ["append_only", "revisable_with_provenance"], "default": "revisable_with_provenance" },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  }
}
