    "developmental_memory_preserves_transfer_and_failure_to_generalise": true,
    "developmental_memory_does_not_become_identity_law": true,
    "selected_lesson_is_not_dataset": true,
    "dataset_is_not_training_authority": true,
    "heldout_contamination_blocks_training_bundle": true,
