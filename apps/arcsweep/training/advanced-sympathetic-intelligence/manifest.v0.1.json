    "materialisation_does_not_expand_authority": true,
    "materialised_experiment_proposal_is_not_execution": true,
    "reflection_is_shareable_judgement_not_private_chain_of_thought": true,
    "reflection_is_curriculum_candidate_not_automatic_training": true,
    "reflection_does_not_write_memory_automatically": true,
