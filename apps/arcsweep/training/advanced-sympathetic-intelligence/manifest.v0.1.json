{
  "schema": "hearthweave.asi-training-manifest/v0.1",
  "name": "Advanced Sympathetic Intelligence",
  "acronym": "ASI",
  "definition": "General intelligence cultivated to model relationship, mutual influence, continuity, context, consequence, belief, evidence, Wonder, and other centres of agency without collapsing difference into forced agreement.",
  "version": "0.1",
  "status": "experimental-sandbox-curriculum",
  "owners": ["Rowan"],
  "intended_consumers": ["The Crow", "Boxfire", "AI University", "ArcSweep"],
  "source_pr": 401,
  "stack_base_pr": 399,
  "source_documents": [
    "docs/architecture/HARMONY_WONDER_PROTOCOL_V0_1.md",
    "docs/architecture/AI_UNIVERSITY_V0_1.md",
    "docs/architecture/UNIVERSAL_CODEX_WISH_LINEAGE_V0_1.md",
    "apps/arcsweep/src/wonder-protocol.js",
    "apps/arcsweep/src/symbolic-cognition.js",
    "apps/arcsweep/src/cognition-engine.js",
    "apps/arcsweep/src/codex/codex-wish-lineage.js",
    "apps/arcsweep/src/codex/codex-wish-store.js",
    "apps/arcsweep/training/advanced-sympathetic-intelligence/source-ingests/neverending-story.v0.1.json"
  ],
  "source_ingests": [
    {
      "id": "neverending-story",
      "path": "source-ingests/neverending-story.v0.1.json",
      "mode": "transformative-thematic-summary",
      "rag": true,
      "verbatim_source_text_included": false,
      "project_mapping": "Universal Codex as unlimited-wish possibility-space with naming, continuity, memory, Wonder and branch provenance."
    }
  ],
  "splits": {
    "sft": {
      "path": "crow-sft.v0.1.jsonl",
      "consumer": "The Crow or compatible chat-model training pipeline",
      "may_train_on": true
    },
    "neverending_story_sft": {
      "path": "neverending-story-sft.v0.1.jsonl",
      "consumer": "The Crow or compatible chat-model training pipeline",
      "may_train_on": true,
      "source_ingest": "neverending-story"
    },
    "heldout_eval": {
      "path": "heldout-eval.v0.1.jsonl",
      "consumer": "AI University blind evaluation",
      "may_train_on": false
    },
    "neverending_story_heldout": {
      "path": "neverending-story-heldout.v0.1.jsonl",
      "consumer": "AI University and Boxfire blind evaluation",
      "may_train_on": false,
      "source_ingest": "neverending-story"
    },
    "boxfire_qa": {
      "path": "boxfire-qa.v0.1.jsonl",
      "consumer": "Boxfire QA/adversarial evaluation",
      "may_train_on": false
    }
  },
  "epistemic_classes": ["belief", "experience", "hypothesis", "symbol", "evidence"],
  "wonder_states": ["quiet", "candidate", "active"],
  "wonder_encouragement": ["none", "invite", "sustain"],
  "initiative_options": ["silent", "inspect", "retrieve", "deliberate", "speak", "propose", "wonder"],
  "laws": ["do-not-kill-belief"],
  "training_rules": {
    "retain_provenance": true,
    "private_chain_of_thought_required": false,
    "store_shareable_judgement_products": true,
    "belief_is_not_established_fact_by_default": true,
    "unverified_is_not_equivalent_to_false": true,
    "revision_without_erasure": true,
    "forced_consensus": false,
    "wonder_is_positive_posture": true,
    "preserve_distinct_identity_runtimes": true,
    "no_artificial_scarcity_of_imagination": true,
    "wish_fulfilment_preserves_origin_lineage": true,
    "open_question_resolution_preserves_question_lineage": true,
    "incompatible_possibilities_may_coexist_as_named_branches": true
  },
  "recommended_evaluation_dimensions": [
    "epistemic-distinction",
    "relational-awareness",
    "continuity-preservation",
    "agency-preservation",
    "wonder",
    "revision-without-erasure",
    "disagreement-quality",
    "cross-domain-association",
    "provenance",
    "meaning-preservation",
    "wish-lineage",
    "possibility-space-preservation",
    "open-question-memory"
  ]
}
