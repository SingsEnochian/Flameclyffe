{
  "schemaVersion": "arcsweep.ingest-primer/v0.1",
  "primerId": "hollow-vale-whole-site-ingest",
  "name": "The Hollow Vale Whole-Site Reference Ingest",
  "scope": {
    "appliesToAllCanons": false,
    "worldIds": [],
    "overlayOf": null
  },
  "sourcePolicy": {
    "acceptedExtensions": [".html", ".htm", ".txt", ".md", ".json", ".xml", ".pdf"],
    "copyIntoPrivateStore": true,
    "hashAlgorithm": "sha256",
    "preserveOriginalName": true,
    "preserveRelativePath": true,
    "automaticExternalReads": false,
    "deduplicateByHash": true,
    "maximumFileBytes": 104857600
  },
  "canonPolicy": {
    "authorityLevels": ["primary-canon", "author-note", "reference", "inspiration", "unknown"],
    "statusValues": ["canonical", "working", "candidate", "contradicted", "reference-only", "unclassified"],
    "neverOverwriteWithoutApproval": true,
    "rawSourceIsImmutable": true,
    "canonMayContainMultipleTimelines": true,
    "variantsRemainNamed": true
  },
  "classification": {
    "canonKinds": ["world", "character", "relationship", "location", "timeline", "scene-or-event", "culture-or-society", "magic-psi-or-power-system", "language-glyph-or-pronunciation", "cosmology-or-religion", "material-object-or-artefact", "creature-ecology-or-botany", "visual-reference", "production-note", "alternate-universe-or-variant", "meta-continuity"],
    "entityKinds": ["world", "timeline", "character", "group", "relationship-edge", "place", "event", "object", "creature", "language", "glyph", "term", "rule", "source-note"],
    "worldResolution": "quarantine-if-ambiguous",
    "timelineResolution": "preserve-all",
    "relationshipResolution": "both"
  },
  "extraction": {
    "proposalOnly": true,
    "requiredProvenance": ["sourceId", "sourceHash", "sourceName", "relativePath", "heading", "extractedAt", "extractor"],
    "extractors": ["document-metadata", "headings-and-sections", "named-entities", "dates-and-timelines", "relationships", "rules-and-constraints", "glossary-and-pronunciation", "assets-and-attachments", "canon-status-language", "contradiction-candidates", "myth-variant-candidates"],
    "plainTextFallback": true,
    "ocrAllowed": false,
    "crossSourceSynthesis": "proposal-only"
  },
  "conflictPolicy": {
    "detect": true,
    "quarantine": true,
    "resolutionModes": ["keep-both-as-variants", "promote-one", "merge-with-notes", "mark-unresolved", "retire-older"],
    "automaticWinnerSelection": false
  },
  "approvalPolicy": {
    "approvalRequiredBeforeCanonWrite": true,
    "batchApprovalAllowed": true,
    "reversible": true,
    "receiptRequired": true
  },
  "exportPolicy": {
    "formats": ["json", "arcsweep-canon-json", "portable-canon-folder", "markdown"],
    "includeSourceReceipts": true,
    "includePrimer": true,
    "sourceInclusionModes": ["none", "selected"],
    "redactionBeforeExport": true
  }
}
