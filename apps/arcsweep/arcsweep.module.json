{
  "moduleId": "arcsweep",
  "name": "Hearthgate: Arcsweep",
  "version": "0.2.0",
  "delivery": "local-core",
  "hosts": ["standalone", "hearthgate"],
  "entrypoint": "index.html",
  "route": "/arcsweep/",
  "storage": {
    "default": "browser-local-storage",
    "automaticUpload": false,
    "exportFormats": ["json"],
    "futureDesktopStorage": "hearthgate-data/arcsweep/"
  },
  "capabilities": [
    "world-registry",
    "polymorphic-world-interface",
    "summon-cue",
    "veil-mode",
    "arrival-context",
    "world-clock",
    "world-competencies",
    "safety-weave",
    "continuity-recall",
    "consent-shaped-companion",
    "per-world-applet-deck",
    "script-editor",
    "waking-thread",
    "time-ratio-calculator",
    "arc-session-ledger",
    "return-orientation",
    "intention-forge",
    "appearance-profile",
    "json-import-export"
  ],
  "languageContract": {
    "preferred": ["Waking Thread", "Continuity Log", "arc", "return", "World Registry", "Safety Weave"],
    "forbidden": ["clone"],
    "noDisclaimers": true,
    "rule": "Disclaimers are never needed.",
    "implementation": "State any actual limitation, uncertainty, boundary, or required condition directly where it applies. Do not add generic warning prefaces, defensive throat-clearing, or padded safety language."
  },
  "provenanceContract": {
    "timeRatioSource": "user-authored world configuration",
    "continuitySources": ["self-entered", "trusted person", "calendar", "imported note", "other"],
    "sourceConcepts": [
      "Community LIFA app traditions",
      "Extremely unusual and helpful things to script community post"
    ],
    "adaptation": "Hearthgate local continuity and world-interface instrument"
  },
  "consentContract": {
    "returnAlwaysAvailable": true,
    "anchors": ["Feather", "Wrap", "Notch", "Seldrin clear"],
    "noAutomaticExternalReads": true,
    "companionAgency": "Companions may speak honestly, refuse, negotiate, rest, change, and leave. Loyalty is relational, not compulsory."
  },
  "interfaceContract": {
    "engine": "one local Arcsweep world model",
    "surfaces": ["portal", "journal", "mirror", "pearl", "watch", "moving-picture", "candle", "familiar", "custom"],
    "perWorldConfiguration": true,
    "summonIsIntentional": true,
    "veilModeIsPerWorld": true
  }
}
