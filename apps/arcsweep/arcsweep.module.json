{
  "schemaVersion": "arkfire.module/v1",
  "moduleId": "arkfire.arcsweep",
  "canonicalName": "Hearthgate: Arcsweep",
  "version": "0.3.0",
  "status": "IMPLEMENTATION_IN_PROGRESS",
  "owner": "Rowan",
  "maintainers": [],
  "description": "A private, local-first world planning, continuity, scripting, canon-ingestion, timing, asset, and return instrument.",
  "standalone": true,
  "standaloneEntrypoints": {
    "webDevelopment": "npm run arcsweep:dev",
    "webBuild": "npm run arcsweep:build",
    "windowsInstaller": "apps/arcsweep/desktop/npm run electron:build:win"
  },
  "standaloneInterface": ["desktop-ui", "local-web-development-ui"],
  "standaloneDataDirectory": "%APPDATA%/Hearthgate/Arcsweep",
  "standaloneHealthCheck": "Settings and Recovery room",
  "standaloneTestCommand": "npm run arcsweep:test",
  "hostAdapters": [
    {
      "host": "Hearthgate: Arkfire",
      "status": "specified-not-connected",
      "optional": true,
      "reversible": true
    }
  ],
  "storage": {
    "desktop": "atomic-json-local-store",
    "stateFile": "state/arcsweep-state.json",
    "backups": "backups/*.json",
    "attachments": "attachments/*",
    "canonSources": "canons/<canon-id>/sources/*",
    "canonManifests": "canons/<canon-id>/canon.json",
    "ingestPrimers": "canons/<canon-id>/primer.json",
    "receipts": "receipts/*.jsonl",
    "exports": "exports/*",
    "browserDevelopmentFallback": "localStorage",
    "automaticUpload": false,
    "exportFormats": ["json", "arcsweep-canon-json", "portable-canon-folder"]
  },
