# Hearthgate / Wayglass local runtime secrets.
# Copy this file to .env on the machine running apps/starwell-server.
# Never commit the resulting .env file. Root .gitignore excludes .env and .env.*.

# HUMAIN Node sandbox route used by Wayglass.
HUMAIN_NODE_SANDBOX_KEY=
# Optional overrides; defaults target HUMAIN Node's OpenAI-compatible API.
# HUMAIN_NODE_SANDBOX_URL=https://api.node.humain.com/v1/chat/completions
# HUMAIN_NODE_SANDBOX_CATALOGUE_URL=https://api.node.humain.com/v1/models
# WAYGLASS_HUMAIN_SANDBOX_MODEL=humain-m3

# Rarity ⇄ Wayglass MCP bridge.
# Prefer WAYGLASS_RARITY_ACCESS_TOKEN or place the same bearer token in:
# apps/starwell-server/data/wayglass-rarity-access.local.txt
WAYGLASS_RARITY_ACCESS_TOKEN=
# Optional explicit token file path.
# WAYGLASS_RARITY_ACCESS_FILE=
# Optional local conversation ledger path.
# WAYGLASS_RARITY_MCP_STORE=
# Optional internal Hearthgate origin. Defaults to http://127.0.0.1:$PORT.
# WAYGLASS_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Preserve the current Bluebird route. Override only when Wayglass moves him.
WAYGLASS_RARITY_BLUEBIRD_ROUTE=flame:bluebird:spicychat
