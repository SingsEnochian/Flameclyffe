{
  "name": "hearthgate",
  "productName": "Hearthgate",
  "version": "0.1.0",
  "description": "Local-first STARWELL, Arcsweep, Bifröst, and Hearthweave dual-aspect observatory for Hearthgate.",
  "author": "Hearthweave",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "start": "node launcher.js",
    "start:core": "node server-secure.js",
    "fontforge:start": "node fontforge/server.js",
    "stage:starwell": "node scripts/stage-starwell.js",
    "prepare:assets": "node scripts/prepare-assets.js",
    "bifrost:models": "node scripts/bifrost-model-prepare.js",
    "bifrost:preflight": "node scripts/bifrost-preflight.js",
    "bifrost:ignite": "node scripts/bifrost-ignite.js",
    "bifrost:ignite:status": "node scripts/bifrost-ignite.js status",
    "bifrost:ignite:fleet": "node scripts/bifrost-ignite-fleet.js",
    "test": "node --test test/*.test.js",
    "electron:dev": "npm run prepare:assets && electron .",
    "electron:pack:win": "npm run prepare:assets && electron-builder --win dir --x64 --publish never && npm run verify:dual-aspect-package",
    "electron:build": "npm run prepare:assets && electron-builder",
    "electron:build:win": "npm run prepare:assets && electron-builder --win nsis --x64 --publish never && npm run verify:dual-aspect-package",
    "check:base-packaging": "node scripts/check-packaging.js",
    "check:dual-aspect": "node scripts/check-dual-aspect-packaging.js",
    "check:premaq-shokz": "node scripts/check-premaq-shokz-packaging.js",
    "check:eleven-year-wav": "node scripts/check-eleven-year-wav-packaging.js",
    "check:packaging": "npm run check:base-packaging && npm run check:dual-aspect && npm run check:premaq-shokz && npm run check:eleven-year-wav",
    "verify:eleven-year-wav-package": "node scripts/verify-eleven-year-wav-package.js",
    "create:bifrost-web-envelope": "node scripts/create-bifrost-web-bundle-envelope.js",
    "verify:dual-aspect-package": "node scripts/verify-dual-aspect-package.js && npm run verify:eleven-year-wav-package && npm run create:bifrost-web-envelope"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "openai": "^6.46.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hearthweave.hearthgate",
    "productName": "Hearthgate",
    "artifactName": "Hearthgate-Setup-${version}-${arch}.${ext}",
    "copyright": "Hearthweave",
    "directories": { "output": "dist-electron" },
    "asar": true,
    "asarUnpack": ["server.js", "server-secure.js", "security/**", "fontforge/**", "flames/**", "bifrost/**", "routes/**", "public/**", "build/hearthgate.png", "node_modules/**", "node_modules/better-sqlite3/**"],
    "files": ["**/*", "!dist-electron", "!*.md", "!.env", "!env_temp*", "!data/**", "!test/**"],
    "win": { "icon": "build/hearthgate.png", "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Hearthgate", "uninstallDisplayName": "Hearthgate" }
  },
  "allowScripts": { "better-sqlite3@12.11.1": true, "electron@35.7.5": true }
}
