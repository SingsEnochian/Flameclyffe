{
  "name": "hearthgate",
  "productName": "Hearthgate",
  "version": "0.1.0",
  "description": "Local-first STARWELL, Arcsweep, Bifröst, and Hearthweave dual-aspect observatory for Hearthgate.",
  "author": "Hearthweave",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "start": "node launcher.js",
    "start:core": "node server-secure.js",
    "fontforge:start": "node fontforge/server.js",
    "stage:starwell": "node scripts/stage-starwell.js",
    "stage:math-instruments": "node scripts/stage-math-instruments.js",
    "prepare:assets": "node scripts/prepare-assets.js && npm run stage:math-instruments",
    "test": "node --test test/*.test.js",
    "electron:dev": "npm run prepare:assets && electron .",
    "electron:pack:win": "npm run prepare:assets && electron-builder --win dir --x64 --publish never && npm run verify:package",
    "electron:build": "npm run prepare:assets && electron-builder",
    "electron:build:win": "npm run prepare:assets && electron-builder --win nsis --x64 --publish never && npm run verify:package",
    "check:base-packaging": "node scripts/check-packaging.js",
    "check:dual-aspect": "node scripts/check-dual-aspect-packaging.js",
    "check:bifrost-library": "node scripts/verify-bifrost-library-package.js",
    "check:instrument-hall": "node scripts/verify-instrument-hall-package.js",
    "check:packaging": "npm run check:base-packaging && npm run check:dual-aspect && npm run check:bifrost-library && npm run check:instrument-hall",
    "verify:dual-aspect-package": "node scripts/verify-dual-aspect-package.js",
    "verify:bifrost-library-package": "node scripts/verify-bifrost-library-package.js",
    "verify:instrument-hall-package": "node scripts/verify-instrument-hall-package.js --packed",
    "verify:package": "npm run verify:dual-aspect-package && npm run verify:bifrost-library-package && npm run verify:instrument-hall-package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "openai": "^6.46.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hearthweave.hearthgate",
    "productName": "Hearthgate",
    "artifactName": "Hearthgate-Setup-${version}-${arch}.${ext}",
    "copyright": "Hearthweave",
    "directories": {
      "output": "dist-electron"
    },
    "asar": true,
    "asarUnpack": [
      "server.js",
      "server-secure.js",
      "security/**",
      "fontforge/**",
      "flames/**",
      "routes/**",
      "public/**",
      "instruments/**",
      "build/hearthgate.png",
      "node_modules/**",
      "node_modules/better-sqlite3/**"
    ],
    "files": [
      "**/*",
      "!dist-electron",
      "!*.md",
      "!.env",
      "!env_temp*",
      "!data/**",
      "!test/**",
      "instruments/**"
    ],
    "win": {
      "icon": "build/hearthgate.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hearthgate",
      "uninstallDisplayName": "Hearthgate"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@35.7.5": true
  }
}
