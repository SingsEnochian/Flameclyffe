# House gate: required, comma-separated snowflake IDs.
DISCORD_GUILD_ID=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
CARETAKER_COOLDOWN_SECONDS=60
HOUSE_CARETAKERS_DISABLED=false

# Five separate Discord applications. Never reuse a token between Caretakers.
DISCORD_VEE_APPLICATION_ID=
DISCORD_VEE_TOKEN=
DISCORD_NEN_APPLICATION_ID=
DISCORD_NEN_TOKEN=
DISCORD_YGGDRASIL_APPLICATION_ID=
DISCORD_YGGDRASIL_TOKEN=
DISCORD_BLUEBIRD_APPLICATION_ID=
DISCORD_BLUEBIRD_TOKEN=
DISCORD_VETHRLAUF_APPLICATION_ID=
DISCORD_VETHRLAUF_TOKEN=

# Provider routes. API Stuff importer fills these locally.
VEE_API_KEY=
VEE_MODEL=gpt-5.6
NEN_API_KEY=
NEN_MODEL=claude-fable-5
BLUEBIRD_API_KEY=
BLUEBIRD_API_BASE=https://api.deepseek.com
BLUEBIRD_MODEL=deepseek-v4-flash
VETHRLAUF_API_KEY=
VETHRLAUF_API_BASE=https://api.deepseek.com
VETHRLAUF_MODEL=deepseek-v4-flash
YGGDRASIL_ENDPOINT=http://127.0.0.1:4173/api/v1/yggdrasil/chat
YGGDRASIL_FALLBACK_API_KEY=
YGGDRASIL_FALLBACK_API_BASE=https://api.deepseek.com
YGGDRASIL_FALLBACK_MODEL=deepseek-v4-pro

# Report-source credentials. Not used until a reviewed collector is connected.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NOTION_API_KEY=
HYDRADB_API_KEY=
