    "dreaming-grove": {
      "root_hz": 174,
      "macro_cycle_seconds": 80,
      "harmonics": [
        { "ratio": 1.0, "gain": 0.52, "type": "sine" },
        { "ratio": 0.5, "gain": 0.30, "type": "sine" },
        { "ratio": 2.0, "gain": 0.12, "type": "sine" }
      ],
      "filter": { "type": "lowpass", "base_hz": 320, "premaq_axis": "Q", "premaq_depth": 260 },
      "lfo": { "rate_hz": 0.01250, "depth_hz": 16 },
      "reverb": { "delay_s": 0.20, "feedback": 0.32, "mix": 0.18 },
      "master_gain": 0.28
