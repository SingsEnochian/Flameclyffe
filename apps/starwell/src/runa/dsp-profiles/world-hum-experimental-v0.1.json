    "momento-creationis": {
      "root_hz": 432,
      "macro_cycle_seconds": 60,
      "harmonics": [
        { "ratio": 1.0,   "gain": 0.36, "type": "sine", "label": "root" },
        { "ratio": 1.333, "gain": 0.26, "type": "sine", "label": "fourth" },
        { "ratio": 1.667, "gain": 0.18, "type": "sine", "label": "major-sixth" },
        { "ratio": 2.0,   "gain": 0.12, "type": "sine", "label": "octave" },
        { "ratio": 2.667, "gain": 0.06, "type": "sine", "label": "upper-fourth" }
      ],
      "filter": { "type": "lowpass", "base_hz": 1100, "premaq_axis": "R", "premaq_depth": 800 },
      "lfo": { "rate_hz": 0.01667, "depth_hz": 52 },
      "reverb": { "delay_s": 0.06, "feedback": 0.24, "mix": 0.16 },
      "master_gain": 0.34
    }
  }
}
