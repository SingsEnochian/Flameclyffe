{
  "schemaVersion": "0.1.0",
  "moduleId": "signal-well",
  "displayName": "Signal Well",
  "version": "0.2.0",
  "delivery": "bundled-core",
  "enabledByDefault": true,
  "route": "/starwell/signal-well/",
  "entrypoint": "signal-well/index.html",
  "capabilities": [
    "local-file-ingest",
    "live-observatory-readings",
    "signal-source-array",
    "display-media-recording",
    "timed-json-snapshots",
    "live-recording-receipt",
    "waterfall-rendering",
    "time-frequency-selection",
    "human-led-candidate-ledger",
    "rfi-comparison",
    "json-session-export",
    "csv-candidate-export",
    "source-receipt"
  ],
  "acceptedInputs": [
    {
      "mediaType": "text/csv",
      "extensions": [".csv"]
    },
    {
      "mediaType": "application/json",
      "extensions": [".json"]
    },
    {
      "mediaType": "video/webm",
      "extensions": [".webm"]
    }
  ],
  "storage": {
    "mode": "local-first",
    "rawImmutable": true,
    "annotationsAppendOnly": true,
    "dataDirectory": "modules/signal-well"
  },
  "extensionContract": {
    "apiVersion": "0.1.0",
    "discoveryDirectory": "modules/signal-well/adapters",
    "adapterKinds": [
      "live-stream",
      "radio-hardware",
      "telescope-archive",
      "binary-decoder",
      "event-feed",
      "machine-data-feed",
      "sonification"
    ],
    "bundledAdapters": [
      "radio-jove-live"
    ]
  },
  "sourceArray": {
    "defaultSelection": "all",
    "recorder": "display-media-with-audio-requested",
    "machineSnapshotCadenceSeconds": 60,
    "receiptSchema": "signal_well_live_recording@0.1.0"
  },
  "plannedAdapters": [
    "sdrplay-rsp1b",
    "breakthrough-listen-archive",
    "e-callisto-fits-ingest",
    "brams-wav-ingest",
    "superdarn-websocket",
    "chime-frb-voevent",
    "filterbank-hdf5-fits",
    "iq-audio-sonification"
  ]
}
