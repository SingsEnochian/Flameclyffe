{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "House Workspace OS",
  "version": "0.1.0",
  "identifier": "house.flameclyffe.workspace",
  "build": {
    "frontendDist": "../../agent-workspace"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "House Workspace OS",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
