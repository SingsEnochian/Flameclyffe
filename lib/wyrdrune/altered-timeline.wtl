// WAYGLASS · ALTERED TIMELINE · DOUBLE MÖBIUS
// Owner-directed hypothetical intervention. This computes *display intensities*
// only: not event predictions, observed correlations, probabilities, or physical
// timeline changes. The host must verify explicit choice and Feather separately.

mobius {
  perceive {
    let change_strength = bridge("scenario", "magnitude");
    let choice = bridge("scenario", "confirmed");
  }
  compress {
    let near_face = change_strength * 0.72;
  }
  release {
    let middle_face = near_face * 0.55;
  }
  verify {
    emit {kind:"outer-face-check",chosen:choice,source:"owner-authored-scenario"};
  }
  integrate {
    let anchored = change_strength;
  }
  choose {
    emit {kind:"outer-face",origin_intensity:anchored,first_ripple:near_face};
  }
  return {
    emit "Return preserves the original history and its provenance";
  }
  transcend {
    emit "No consequence is promoted from possibility to observation";
  }
}

mobius {
  perceive {
    let far_face = middle_face * 0.55;
  }
  compress {
    let echo_face = far_face * 0.4;
  }
  release {
    let maximum_ripple = change_strength;
  }
  verify {
    emit {kind:"inner-face-check",reversible:true,choice:choice};
  }
  integrate {
    let withness = "original + altered branch + unresolved consequences";
  }
  choose {
    emit {
      schema:"wayglass.altered-timeline-ripple/v0.1",
      mode:"hypothetical",
      reversible:true,
      requires_explicit_choice:true,
      confirmed:choice,
      probability_claimed:false,
      inferred_events:0,
      levels:[
        {id:"near",label:"First ripple",intensity:near_face},
        {id:"middle",label:"Second ripple",intensity:middle_face},
        {id:"far",label:"Third ripple",intensity:far_face},
        {id:"echo",label:"Open echo",intensity:echo_face}
      ],
      withness:withness
    };
  }
  return {
    emit "Both histories remain inspectable and independent";
  }
  transcend {
    emit "Only an authorised world-native act can promote branch canon";
  }
}
